<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE data_def SYSTEM "swim.dtd">
<data_def>
    <!--
   Default mapping file for the Teamcenter Integration for SolidWorks
   For a description of the contents of this file and
   how it may be customized for your site, please see the section
   titled "swim.xml" in the Teamcenter Integration for SolidWorks Admin Guide.
-->
    <type_map>
        <entity cad_type="sldasm" pdm_type="SWAsm"/>
        <entity cad_type="sldprt" pdm_type="SWPrt"/>
        <entity cad_type="slddrw" pdm_type="SWDrw"/>
        <entity cad_type="sldtbx" pdm_type="SW2Tbx"/>
        <entity cad_type="sldlfp" pdm_type="SW2Lfp"/>
        <entity cad_type="asmdot" pdm_type="SW2Asmdot"/>
        <entity cad_type="prtdot" pdm_type="SW2Prtdot"/>
        <entity cad_type="drwdot" pdm_type="SW2Drwdot"/>
    </type_map>
	<template_map>
        <template cad_type="sldprt" item_id="sldprt"/>
        <template cad_type="sldasm" item_id="sldasm"/>
        <template cad_type="slddrw" item_id="slddrw"/>		
	</template_map>
    <dataset_map>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="AsmFile" pdm_type="SWAsm"/>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="PrtFile" pdm_type="SWPrt"/>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="DrwFile" pdm_type="SWDrw"/>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="TbxFile" pdm_type="SW2Tbx"/>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="SW2LfpFile" pdm_type="SW2Lfp"/>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="SW2AsmdotFile" pdm_type="SW2Asmdot"/>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="SW2PrtdotFile" pdm_type="SW2Prtdot"/>
        <dataset allowed_item_types="Y6_TY_D_Product:Y6_TY_D_GenParts:Y6_TY_D_STDParts:Y6_TY_D_Tooling" named_ref="SW2DrwdotFile" pdm_type="SW2Drwdot"/>
    </dataset_map>
	 <attribute_map cad_type="slddrw:sldasm:sldprt">
        <attribute>
            <cad_name value="名称"/>
            <pdm_name value="item_name"/>
			<missing_attribute_action value="create"/>
            <direction value="both"/>
        </attribute>
		<attribute>
            <cad_name value="代号"/>
            <pdm_name value="item_id"/>
			<missing_attribute_action value="create"/>
            <direction value="both"/>
        </attribute>
        <attribute>
            <cad_name value="版本"/>
            <pdm_name value="ItemRevision.item_revision_id"/>
			<missing_attribute_action value="create"/>
            <direction value="both"/>
        </attribute>
        <attribute>
            <cad_name value="材料"/>
            <pdm_name value="ItemRevision.y6_MaterialSply"/>
			<missing_attribute_action value="create"/>
            <direction value="both"/>
        </attribute>
        <attribute>
            <cad_name value="重量"/>
            <pdm_name value="ItemRevision.y6_NetWeight"/>
			<missing_attribute_action value="create"/>
            <direction value="both"/>
        </attribute>
        <attribute>
            <cad_name value="备注"/>
            <pdm_name value="ItemRevision.y6_AddInfo"/>
			<missing_attribute_action value="create"/>
            <direction value="both"/>
        </attribute>
    </attribute_map>
    <!-- Uncomment the attribute_map section below to enable those sample attribute mappings -->
    <!-- 
  <attribute_map cad_type="sldasm:sldprt:sldtbx:sldlfp">
    <attribute>
        <cad_name value="Description"/>
        <pdm_name value="item_name"/>
        <direction value="cadtopdm"/>
    </attribute>
    <attribute>
        <cad_name value="Description"/>
        <pdm_name value="ItemRevision.object_name"/>
        <direction value="both"/>
    </attribute>
    <attribute>
        <cad_name value="Revision"/>
        <pdm_name value="item_revision_id"/>
        <direction value="pdmtocad"/>
    </attribute>
  </attribute_map>
-->
    <auxiliary_file_map>
        <auxiliary_file cad_type="sldprt" direction="cadtopdm">
            <!-- Uncomment the below if you want to give the user choice of saving the preview files of parts -->
            <!-- cadtopdm_control label="Save Part Preview Files"/ -->
            <pdm_location named_ref="PNG" pdm_type="SWPrt"/>
            <file_name pattern="{temp_dir}\{cad_name}p.PNG"/>
            <preview_command cmd="built_in {temp_dir}\{cad_name}p.PNG" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <auxiliary_file cad_type="sldtbx" direction="cadtopdm">
            <pdm_location named_ref="PNG" pdm_type="SW2Tbx"/>
            <file_name pattern="{temp_dir}\{cad_name}t.PNG"/>
            <preview_command cmd="built_in {temp_dir}\{cad_name}t.PNG" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <auxiliary_file cad_type="sldasm" direction="cadtopdm">
            <pdm_location named_ref="PNG" pdm_type="SWAsm"/>
            <file_name pattern="{temp_dir}\{cad_name}a.PNG"/>
            <preview_command cmd="built_in {temp_dir}\{cad_name}a.PNG" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <auxiliary_file cad_type="slddrw" direction="cadtopdm">
            <pdm_location named_ref="PNG" pdm_type="SWDrw"/>
            <file_name pattern="{temp_dir}\{cad_name}d.PNG"/>
            <preview_command cmd="built_in {temp_dir}\{cad_name}d.PNG" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <auxiliary_file cad_type="sldlfp" direction="cadtopdm">
            <pdm_location named_ref="PNG" pdm_type="SW2Lfp"/>
            <file_name pattern="{temp_dir}\{cad_name}l.PNG"/>
            <preview_command cmd="built_in {temp_dir}\{cad_name}l.PNG" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <jt_file action="translate" cad_type="sldprt:sldtbx" eai_dir="D:\PLM\Siemens\JTTranslators\SolidworksJT_22.0.0"/>
		<!--auxiliary_file cad_type="slddrw" direction="cadtopdm">
            <pdm_location named_ref="PDF_Reference" pdm_type="PDF"/>
            <file_name pattern="{cad_name}.PDF"/>
            <generate_command cmd="built_in {cad_name}.PDF" cad_type="PDF" ignore_status="true" phase="in_directory"/>
        </auxiliary_file-->		
		<auxiliary_file cad_type="sldprt:sldasm">
			<cadtopdm_control label="Save JT Files (Dispatcher)"/>
			<ets_request translator="swtojt" provider="SIEMENS" priority="1"/>
		</auxiliary_file>
		<auxiliary_file cad_type="slddrw">
			<cadtopdm_control label="Save PDF Files (Dispatcher)"/>
			<ets_request translator="swtodxf" provider="SIEMENS" priority="1"/>
		</auxiliary_file>
		<auxiliary_file cad_type="slddrw" direction="cadtopdm">
		 <pdm_location named_ref="PDF_Reference" relation_type="IMAN_Rendering" pdm_type="PDF"/>
		 <file_name pattern="{cad_name}d.PDF"/>
		 <generate_command cmd="built_in {cad_name}d.PDF" cad_type="PDF" ignore_status="true" phase="in_directory"/>
		</auxiliary_file>
    </auxiliary_file_map>
	
    <bom_map>
        <bom_line child_type="sldasm" parent_type="sldasm" view_types="view">
            <!-- Uncomment the line below to set the componentReference -->
            <!-- bom_prop cadName="componentReference" pdmName="bl_sequence_no" direction="pdmtocad"/ -->
        </bom_line>
        <bom_line child_type="sldprt" parent_type="sldasm" view_types="view">
            <!-- Uncomment the line below to set the componentReference -->
            <!-- bom_prop cadName="componentReference" pdmName="bl_sequence_no" direction="pdmtocad"/ -->
        </bom_line>
        <bom_line child_type="sldtbx" parent_type="sldasm" view_types="view">
            <!-- Uncomment the line below to set the componentReference -->
            <!-- bom_prop cadName="componentReference" pdmName="bl_sequence_no" direction="pdmtocad"/ -->
        </bom_line>
        <bom_line child_type="proprt" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="proasm" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="proprt" parent_type="proasm" view_types="view"/>
        <bom_line child_type="proasm" parent_type="proasm" view_types="view"/>
        <bom_line child_type="directmodel" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="catpart" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="catproduct" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="catpart" parent_type="catproduct" view_types="view"/>
        <bom_line child_type="catproduct" parent_type="catproduct" view_types="view"/>
        <bom_line assembly="ignore" child_type="ugmaster" parent_type="sldasm" view_types="view"/>
        <bom_line assembly="ignore" child_type="ugmaster" parent_type="ugmaster" view_types="view"/>
        <bom_line child_type="aipart" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="aiassembly" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="aipart" parent_type="aiassembly" view_types="view"/>
        <bom_line child_type="aiassembly" parent_type="aiassembly" view_types="view"/>
        <bom_line child_type="se part" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="se assembly" parent_type="sldasm" view_types="view"/>
        <bom_line child_type="se part" parent_type="se assembly" view_types="view"/>
        <bom_line child_type="se assembly" parent_type="se assembly" view_types="view"/>
    </bom_map>
    <clone_exclude_model_properties>
        <pdm_property name="item_type"/>
        <pdm_property name="item_name"/>
        <pdm_property name="Dataset.object_type"/>
        <pdm_property name="Dataset.object_name"/>
    </clone_exclude_model_properties>
</data_def>
