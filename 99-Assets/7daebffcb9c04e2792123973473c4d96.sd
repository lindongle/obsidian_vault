##
#
# \brief         Mapping namespace for T4S bill of material transfer
#
# \details       The namespace contains the custom specific part of a T4S bill of material transfer:
#                \li Procedure \b TC_Object2SAP_BillOfMaterial maps Teamcenter attributes of BOM header to SAP attributes (so called \c mapping). 
#                \li Procedure \b TC_Object2SAP_BillOfMaterialPostAction is called after the general mapping in order to perform additional steps.
#                \li Procedure \b TC_Object2SAP_BillOfMaterialPosition maps Teamcenter attributes of BOM line to SAP attributes (so called \c mapping). 
#                \li Procedure \b SAP_BillOfMaterial2TC_Object maps SAP attributes back to Teamcenter attributes (so called \c reverse \c mapping). 
#
# \note          For the data exchange between Teamcenter and T4S the internal TCL dictionary \c ::TcData is used.
#                It contains specific attributes of the Teamcenter object to be transferred 
#                and additional information about the current transaction. 
#                For the data exchange between T4S and SAP the internal TCL array \c ::SAPDat is used.\n
#                Teamcenter attributes can be read from \c ::TcData with function \c ::T4X::TC::MAPPING::IndexedFieldMapping.\n
#                Teamcenter attributes can be written to \c ::TcData with function \c ::T4X::TC::MAPPING::storeReverseMappingAttribute.\n 
#                SAP attributes can be read from \c ::SAPDat with \c $::SAPDat(<key>).\n
#                SAP attributes can be written to \c ::SAPDat with \c set \c ::SAPDat(<key>) \c value.\n 
#
# \pre           For the bill of material transfer the following preferences are used:
#                \li \c T4S_BillOfMaterialTypeList : list of allowed Teamcenter object types
#                \li \c T4S_BillOfMaterialMapping4<ViewType> : list of Teamcenter view types to read attributes from
#                \li \c T4S_BillOfMaterialHeaderTypeList : list of allowed Teamcenter object types for BOM header. Otherwise \c T4S_MaterialMasterTypeList is used
#                \li \c T4S_BillOfMaterialHeaderMapping4<ObjectType> : list of Teamcenter data types for BOM header to read attributes from. Otherwise \c T4S_MaterialMasterMapping4<ObjectType> is used
#                \li \c T4S_BillOfMaterialLineMapping4<ObjectType> : list of Teamcenter data types for BOM lines to read attributes from. Otherwise \c T4S_MaterialMasterMapping4<ObjectType> is used
#                \li \c T4S_BillOfMaterialOccurrenceNotes4<ViewType> : list of Teamcenter occurence notes for BOM lines to read attributes from.
#                \li \c T4S_BillOfMaterialMapping2<ViewType> : list of Teamcenter view types to write back during reverse mapping
#                \li \c T4S_BillOfMaterialFieldMapping2<DataType> : list of Teamcenter attributes to write back during reverse mapping (optional)
#
# \author        M.L., 20130510
#
# ------------------------------------------------------------------------------------------------------ 

namespace eval ::T4S::BOM::CUSTOM::MAPPING 
{
  namespace export TC_Object2SAP_BillOfMaterial
  namespace export TC_Object2SAP_BillOfMaterialPostAction
  namespace export TC_Object2SAP_BillOfMaterialPosition
  namespace export SAP_BillOfMaterial2TC_Object

  # Enable access
  variable BomPositionInfo
  variable BomHeaderInfo
  
  # ------------------------------------------------------------------------------------------------------
  # Method:        ::T4S::BOM::CUSTOM::MAPPING::TC_Object2SAP_BillOfMaterial
  ##
  #
  # \brief         Customer specific mapping function to define the bill of material header data to be transferred to SAP 
  #
  # \details       This procedure is called one time to prepare the bill of material header data. \n
  #                It maps the Teamcenter attributes \c user_data_1 
  #                and some default values defined in \c t4s_mapping_config.sd to SAP attributes. \n
  #                For bill of material (BOM) transfer the Teamcenter attribute \c user_data_1 shall contain 
  #                the SAP Id of the material master for which the BOM should be created/updated in SAP. 
  #                Otherwise the user will get an error message.
  #
  # \param         TransactionId Unique ID for the transfer transaction
  # \param         ItemType Teamcenter item type
  # \param         ItemRevisionType Teamcenter item revision type
  # \param         args Not used
  #
  # \return        Return code used by the following transfer function. 
  #                The following values are valid:
  #                \li \c OK                 -> T4S will continue with the next transfer step
  #                \li \c REVERSEMAPPINGONLY -> T4S will skip the transfer to SAP and will just do the reverse mapping 
  #                \li \c SKIPPED            -> T4S will skip the transfer to SAP
  #                \li \c ERROR              -> T4S will stop transfer and raise an error
  #
  # \author        M.L., 20130510
  #
  # ------------------------------------------------------------------------------------------------------
  
  proc TC_Object2SAP_BillOfMaterial {TransactionId ItemType ItemRevisionType args} {

    # Enable access
    variable BomPositionInfo

    # Reset some internal variables
    set ::errorCode "NONE"
    set ::errorInfo ""
    set BomPositionInfo(BomLineIndex) 0
  
    # Define default return code
    set rc "OK"

    # Store procedure name in variable
    set FunctionName "[lindex [info level 0] 0]"

    # Write information to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName starts with $ItemType, $ItemRevisionType"
  
    # Define some relation name strings
    set Item                 "$ItemRevisionType:items_tag:$ItemType"
    set ItemRev              $ItemRevisionType
   #set ItemRevMaster        "$ItemRevisionType:IMAN_master_form_rev:$ItemRevisionType Master"
   #set CN                  "$ItemRevisionType:aen4SolutionOf:DZ8_DJ_ECNRevision:items_tag:DZ8_DJ_ECN"
   #set BomViewRev          "$ItemRevisionType:structure_revisions:PSBOMViewRevision"
	#set CNTEST            "$ItemRevisionType:DZ8_CR_REL:DZ8_DJ_ECNRevision:items_tag:DZ8_DJ_ECN"
	set ItemUom             "$ItemRevisionType:items_tag:$ItemType:uom_tag:UnitOfMeasure"

    # Read some attributes from Teamcenter object
    #set SAPId   [::T4X::TC::MAPPING::IndexedFieldMapping "0" $ItemRevMaster user_data_1];   # contains SAP Id if data exist in SAP
	set SAPId   [::T4X::TC::MAPPING::IndexedFieldMapping "0" $Item item_id];   # contains SAP Id if data exist in SAP
	set REV_ID [::T4X::TC::MAPPING::IndexedFieldMapping "0" $ItemRev item_revision_id]
	set ItemName [::T4X::TC::MAPPING::IndexedFieldMapping "0" $ItemRev object_name]
    set ItemId  [::T4X::TC::MAPPING::IndexedFieldMapping "0" $Item item_id]
	#set SAPChangeNumber  [::T4X::TC::MAPPING::IndexedFieldMapping "0" $CN item_id]
	#SAPChangeNumber  [::T4X::TC::MAPPING::IndexedFieldMapping "0" $CNTEST item_id]
	set SAPChangeNumber  [::T4X::TC::MAPPING::IndexedFieldMapping "0" $ItemRev dz8_cnno]
	

	set SAPItemUnit       [::T4X::TC::MAPPING::IndexedFieldMapping "0" $ItemUom symbol];	
	if {$SAPItemUnit eq "" }
	{
		set SAPItemUnit "EA"
	} 	
    #set SAPPlant  [::T4X::TC::MAPPING::IndexedFieldMapping "0" $BomViewRev dz8_plant]
	
	
    
    # Check SAP Id 检查物料号在SAP是否已存在，OOTB中配置SAPID和ITEMID，主要用于当TC的物料号不直接为SAP物料号，而是在Item版本属性上体现了SAP物料号的情况。
    if {[string trim $SAPId] eq ""} {
      #::T4X::CORE::storeMessage2 MAPPING "SAP Id is missing for Item Id $ItemId" ERROR
	  ::T4X::CORE::storeMessage2 MAPPING "Item Id $ItemId is  not exist in SAP" ERROR
      set ::SAPDat(CtrlParam:ProhibitedAction) "X"
      set rc "ERROR"
    }    
    # Store data to the data exchange array ::SAPDat
    set ::SAPDat(Bom:BomHeader:MaterialNumber)      [string trim $SAPId]
    set ::SAPDat(Bom:BomHeader:Plant)                $::T4S_Defaults(Plant)
    set ::SAPDat(Bom:BomHeader:BomAlternative)       $::T4S_Defaults(BomAlternative)
    set ::SAPDat(Bom:BomHeader:BomUsage)             $::T4S_Defaults(BomUsage)	
    set ::SAPDat(Bom:BomHeader:BomAlternativeText)   $REV_ID	
    set ::SAPDat(Bom:BomHeader:BomText)              $ItemName
    set ::SAPDat(Bom:BomHeader:BomState)             ""	
    set ::SAPDat(Bom:BomHeader:BomApplication)       $::T4S_Defaults(BomApplication)
    set ::SAPDat(Bom:BomHeader:BomAction)            $::T4S_Defaults(BomAction)	
    set ::SAPDat(Bom:BomHeader:ChangeNumber)         $SAPChangeNumber
    set ::SAPDat(Bom:BomHeader:BomValidFrom)         ""
	set ::SAPDat(Bom:BomHeader:CAD_IND)              "X"	
	set ::SAPDat(Bom:BomHeader:MEINS)                $SAPItemUnit
	

    # Allow transfer of BOM without any BOM positions，允许空BOM（无下级件）创建
    set ::SAPDat(Bom:Parameter:allowEmptyBomTransfer) YES
    
    # Enable position definition inside mapping
    # Initialize the BOM positions with all the data SAP requires for a BOM position:
    set ::T4S::BOM::MAPPING::CtrlParam(AutoInitOfPositionData) FALSE ;# TRUE is default
    # If set to false, you have to set all the data separately in the BOM position mapping or
    # add the following line to the BOM position mapping:

    ::TPSAP::BOM::initPositionStructure $BomPositionInfo(BomLineIndex) 

    #set ::SAPDat(Bom:Parameter:useOldBomFunctions "TRUE"
    #
    # Automatically set SAP BOM position numbers if not set in the BOM position mapping:
	# NO is default，修改为NO，即位置号不自动排序
    set ::SAPDat(Bom:Parameter:useAutoPositionNumbers) NO ;
    #

    
    # Write return code to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName returns $rc"
    
    return $rc
  }
  # ---------------------------------------------------------------------
  ##
  # Method:         ::T4S::BOM::CUSTOM::MAPPING::TC_Object2SAP_BillOfMaterialPostAction
  # \brief          This function is called AFTER the general mapping and can be used
  #                 to perform additional steps after the header and position mapping.
  #
  # \param          TransactionId Unique ID for the transfer transaction
  # \param          PositionIndex Tc BOMLine index
  # \param          ItemType
  # \param          ItemRevisionType
  # \param          MappingStatus
  # \param          args Not used
  #
  # \author         kh, 20131022
  #
  # \return        Return code used by the following transfer function. 
  #                The following values are valid:
  #                \li \c OK                 -> T4S will continue with the next transfer step
  #                \li \c REVERSEMAPPINGONLY -> T4S will skip the transfer to SAP and will just do the reverse mapping 
  #                \li \c SKIPPED            -> T4S will skip the transfer to SAP
  #                \li \c ERROR              -> T4S will stop transfer and raise an error
  #
  #
  proc TC_Object2SAP_BillOfMaterialPostAction { TransactionId ItemType ItemRevisionType MappingStatus args } {
    #
    variable BomPositionInfo
    variable BomHeaderInfo
    #
    set ::errorCode "NONE"
    set ::errorInfo ""
    set Status "OK"
    #
    set FunctionName "[lindex [info level 0] 0]"
    #
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName starts with TransactionId >$TransactionId<, ItemType >$ItemType<, ItemRevisionType >$ItemRevisionType< and MappingStatus >$MappingStatus<"
    #
    # Add your code here...
    #
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName finished with >$Status<"
    #
    return $Status
  }
  
  # ------------------------------------------------------------------------------------------------------
  # Method:        ::T4S::BOM::CUSTOM::MAPPING::TC_Object2SAP_BillOfMaterialPosition
  ##
  #
  # \brief         Customer specific mapping function to define the bill of material position data to be transferred to SAP 
  #
  # \details       This procedure is called one time to prepare the bill of material position data. \n
  #                It maps the Teamcenter attributes \c user_data_1 and \c bl_quantity 
  #                and some default values defined in \c t4s_mapping_config.sd to SAP attributes. \n
  #                Depending on Teamcenter attribute \c bl_ref_designator the BOM line position is determined. \n
  #                The Teamcenter attribute \c user_data_1 shall contain 
  #                the SAP Id of the material master for which the BOM line should be created/updated in SAP. 
  #                Otherwise the user will get an error message if action is not DISPLAY.
  #
  # \param         TransactionId Unique ID for the transfer transaction
  # \param         PositionIndex Teamcenter BOM line index
  # \param         ItemType Teamcenter item type
  # \param         ItemRevisionType Teamcenter item revision type
  # \param         args Not used
  #
  # \return        Return code used by the following transfer function. 
  #                The following values are valid:
  #                \li \c OK                 -> T4S will continue with the next transfer step
  #                \li \c REVERSEMAPPINGONLY -> T4S will skip the transfer to SAP and will just do the reverse mapping 
  #                \li \c SKIPPED            -> T4S will skip the transfer to SAP
  #                \li \c ERROR              -> T4S will stop transfer and raise an error
  #
  # \author        M.L., 20130510
  #
  # ------------------------------------------------------------------------------------------------------
  
  proc TC_Object2SAP_BillOfMaterialPosition {TransactionId PositionIndex ItemType ItemRevisionType args} {

    # Enable access
    variable BomPositionInfo
  
    # Reset some internal variables
    set ::errorCode "NONE"
    set ::errorInfo ""
	set BomPositionInfo(BomLineIndex) 0
  
    # Define default return code
    set rc "OK"

    # Store procedure name in variable
    set FunctionName "[lindex [info level 0] 0]"

    # Write information to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName starts with $PositionIndex, $ItemType, $ItemRevisionType"

    # Define some relation name strings
    set Item                 "$ItemRevisionType:items_tag:$ItemType"
    set ItemRev              $ItemRevisionType
   #set ItemRevMaster        "$ItemRevisionType:IMAN_master_form_rev:$ItemRevisionType Master"
	set BOMUom               "$ItemRevisionType:items_tag:$ItemType:uom_tag:UnitOfMeasure"
    # Read some attributes from Teamcenter object
    #
   #set SAPId               [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex $ItemRevMaster "user_data_1"];   # contains SAP Id if data exist in SAP
    set SAPId               [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex $Item "item_id"];   # contains SAP Id if data exist in SAP
   #set ItemId              [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex $Item "item_id"]
    set SAPQuantity         [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex BOMLine "bl_quantity"]
	set SAPPosition         [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex BOMLine "bl_sequence_no"]
	set SAPBomPositionType  [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex BOMLine "DZ8_bompositiontype"]
	
	
	
	set SAPBomUnit          [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex $BOMUom "symbol"]
	#if {$SAPBomUnit eq "" } 
	#{
	#set SAPBomUnit        [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex $ItemUom symbol]
	#}		
	if {$SAPBomUnit eq "" } {
		set SAPBomUnit "EA"
	} 
	#	else 
	#{
	#		set SAPBomUnit [::CUSTOM::UTILITY::SetMappedValue $SAPBomUnit "T4S_MappingUOMPreference"]
	#}
				
	#bl_ref_designator指引标识符，元器件的器件号。
    set bl_ref_designator [string toupper [::T4X::TC::MAPPING::IndexedFieldMapping $PositionIndex BOMLine "bl_ref_designator"]]
	
	
	
	set SAPPosition [format "%04s" $SAPPosition]
	
	
    # Check SAP Id
    if {[string trim $SAPId] eq ""}
	{
      if {$::TcData(GatewayMode) eq "Portal" && $::TcData(Portal:Action) eq "DISPLAY"} 
	  {
        #
        # Only the portal menu action DISPLAY or PSB will work without a material number for a given Teamcenter BOM line
        #
      } else 
	  {    
        #::T4X::CORE::storeMessage2 MAPPING "SAP Id is missing for BOM position $SAPPosition (Item Id $SAPId)" ERROR
		::T4X::CORE::storeMessage2 MAPPING "BOM position $SAPPosition (Item Id $SAPId) is not exist!" ERROR
        set ::SAPDat(CtrlParam:ProhibitedAction) "X"
        set rc "ERROR"
      }
    }   
	
 	if {$SAPPosition == "" || [string trim $SAPPosition] == 0} 
	{
	 ::T4X::CORE::storeMessage2 MAPPING "BOM position $SAPPosition is empty!" ERROR
	 set rc "ERROR"
	#	set ReturnCode "ERROR"
	#				
	#	::T4X::TRANSLOG::writeCustomMappingLog $TransactionId INFO  "BOM custom mapping does not use Position $PositionIndex: no Teamcenter BOM Sequence No (is it an alternative position?)" 
	#				
	#	::ITK::disconnectTcDB
	#				
	#	return $ReturnCode 
	}

    # Check quantity and set it to 1 if it is empty or zero #如果数量为空或0时，设置的数量的值。
    if {[string trim $SAPQuantity] eq "" || [string trim $SAPQuantity] == 0} 
	{
      set SAPQuantity "1"
    }
	
	
    # Force the number to have exactly three decimals; if the input string is longer, then it is rounded #强制保留3位有效数字
    set SAPQuantity  [format "%0.3f" $SAPQuantity]
	
	
    # Replace the dot in the Quantity string by a comma #使用逗号代替数量中的点。
    regsub -all {\.} $SAPQuantity  {,} SAPQuantity; # Caution: there may be the need to format it in a different way, depending on the SAP system!
	
	
    
    # Try to find the corresponding BOM position in the list if the bl_ref_designator value is defined
    #Position
    if {[string length $bl_ref_designator] > 0}
	{
      set BomLineIndex 0
      foreach BomLine [array names ::SAPDat Bom:Position:POSNR:*] 
	  {
        if {$::SAPDat($BomLine) == $SAPPosition}
		{
          set BomLineIndex [lindex [split $BomLine :] end]
          break
        }
      }
      if {$BomLineIndex == 0}
	  {
        if {$::T4S::BOM::MAPPING::CtrlParam(AutoInitOfPositionData) ne "TRUE"} 
		{
          incr BomPositionInfo(BomLineIndex)
          ::TPSAP::BOM::initPositionStructure $BomPositionInfo(BomLineIndex)
          set BomLineIndex $BomPositionInfo(BomLineIndex)
        } else 
		{
          set BomLineIndex $PositionIndex
        }
	  }
    } else
	{
      if {$::T4S::BOM::MAPPING::CtrlParam(AutoInitOfPositionData) ne "TRUE"} 
	  {
        incr BomPositionInfo(BomLineIndex)
        ::TPSAP::BOM::initPositionStructure $BomPositionInfo(BomLineIndex)
        set BomLineIndex $BomPositionInfo(BomLineIndex)
      } else 
	  {
        set BomLineIndex $PositionIndex
      }
    }
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++++++ BomLineIndex: '$BomLineIndex' +++++++++++++++++++++++++++++++++++"
    
	
	
    # Store data to the data exchange array ::SAPDat

    set ::SAPDat(Bom:Position:POSTP:$BomLineIndex)       $SAPBomPositionType
    set ::SAPDat(Bom:Position:IDNRK:$BomLineIndex)       $SAPId
    set ::SAPDat(Bom:Position:MENGE:$BomLineIndex)       $SAPQuantity
	set ::SAPDat(Bom:Position:POSNR:$BomLineIndex)       $SAPPosition
	set ::SAPDat(Bom:Position:MEINS:$BomLineIndex) 	     $SAPBomUnit
	set ::SAPDat(Bom:Position:CADPO:$BomLineIndex)       "X"
    
    # Write return code to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName returns $rc"
    
    return $rc
 } 
  
  # ------------------------------------------------------------------------------------------------------
  # Method:        ::T4S::BOM::CUSTOM::MAPPING::SAP_BillOfMaterial2TC_Object
  ##
  #
  # \brief         Customer specific reverse mapping function for the T4S bill of material transfer
  #
  # \details       The procedure maps status information back to Teamcenter attributes 
  #                \n \c T4S \c transfer \c status -> \c item_comment  
  #
  # \param         TransactionId Unique ID for the transfer transaction
  # \param         Status SAP transfer status. 
  #                The following values are valid:
  #                \li \c SKIPPED                   -> the transfer was skipped
  #                \li \c ERROR                     -> the transfer was stopped by an error
  #                \li \c EMPTY_BOM_ERROR           -> the transfer was stopped by an error
  #                \li \c UNKNOWN                   -> the transfer was stopped by an unknown error
  #                \li \c UPDATED_WITH_ERROR        -> the transfer was stopped by an minor error in one of the additional transfer steps
  #                \li \c CREATED, \c CHANGED, \c UPDATED -> and some other values are used for a successful transfer
  # \param         args - Not used
  #
  # \return        Return code used by the following Tc object update function. 
  #                The following values are valid:
  #                \li \c OK                 -> T4S will update the Tc object based on the reverse mapping preferences and the reverse mapping buffer
  #                \li \c SKIPPED            -> T4S will skip the TcData object
  #                \li \c ERROR              -> T4S will stop transfer and raise an error
  #
  # \author        M.L., 20130510
  #
  # ------------------------------------------------------------------------------------------------------
  
  proc SAP_BillOfMaterial2TC_Object {TransactionId Status args} {

    # Reset some internal variables
    set ::errorCode "NONE"
    set ::errorInfo ""
  
    # Define default return code
    set rc "OK"

    # Store procedure name in variable
    set FunctionName "[lindex [info level 0] 0]"
    
    # Write information to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName starts with $Status"

    # Define some relation name strings
    set BomViewType         $::TcData(ItemInfo:TypeName)
    set ItemRevisionType    $::TcData(0:ItemInfo:TypeName)
   #set ItemRevMaster       "${ItemRevisionType}:IMAN_master_form_rev:${ItemRevisionType} Master"

    # Return in case of prohibited action
    foreach data [array names ::SAPDat "CtrlParam:ProhibitedAction"] 
	{
      set rc "SKIPPED"
      tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName returns $rc"
      return $rc
    }
    
    # Read some attributes from SAP object and define transfer status string
    #   
    set ItemComment [string trim [::T4X::TC::MAPPING::IndexedFieldMapping "0" $ItemRev "dz8_sapcomment"]]
    set listComment [split $ItemComment "\n"]
    if {[llength $listComment] > 0} 
	{
      set T4STransferStatusBOM [lindex $listComment 0]
    } else
	{
      set T4STransferStatusBOM ""
    }
    
    if {($Status eq "ERROR") || ($Status eq "UNKNOWN") || ($Status eq "SKIPPED") || ($Status eq "UPDATED_WITH_ERROR") || ($Status eq "EMPTY_BOM_ERROR")} 
	{
      set T4STransferStatus "$T4STransferStatusBOM\nBOM $BomViewType transfer $Status - [clock format [clock seconds] -format "%Y-%m-%d %R"]"
    } else 
	{
      set T4STransferStatus "$T4STransferStatusBOM\nBOM $BomViewType transferred to $::T4S::SapInfo(SapSystem) at [clock format [clock seconds] -format "%Y-%m-%d %R"]"
    }

    # Store data to Teamcenter and write information to session log
    #
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'dz8_sapcomment': '$T4STransferStatus' ++++++++++"  
    ::T4X::TC::MAPPING::storeReverseMappingAttribute BomHeader "${BomViewType}:structure_revisions:$ItemRev" dz8_sapcomment $T4STransferStatus
    
    # Write return code to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName returns $rc"
    
    return $rc
  }
  
}