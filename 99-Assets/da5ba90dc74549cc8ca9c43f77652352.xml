<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE data_def SYSTEM "ipem.dtd">
<data_def>
    <!--
   Default mapping file for the Teamcenter Integration for Creo.  
   For a description of the contents of this file and how it may be customized 
   for your site, please see the section titled "The Map File" in the Teamcenter 
   Integration for Creo User Guide.
-->
    <type_map>
        <entity cad_type="ASM" pdm_type="ProAsm"/>
        <entity cad_type="PRT" pdm_type="ProPrt"/>
        <entity cad_type="DRW" pdm_type="ProDrw"/>
        <entity cad_type="FRM" pdm_type="ProFrm"/>
        <entity cad_type="SEC" pdm_type="ProSec"/>
        <entity cad_type="LAY" pdm_type="ProLay"/>
        <entity cad_type="DGM" pdm_type="ProDgm"/>
        <entity cad_type="MFG" pdm_type="ProMfg"/>
        <entity cad_type="MRK" pdm_type="ProMrk"/>
        <entity cad_type="REP" pdm_type="ProRep"/>
        <entity cad_type="GPH" pdm_type="ProGph"/>
        <entity cad_type="CEM" pdm_type="Pro2Cem"/>
        <entity cad_type="JT" pdm_type="DirectModel"/>
    </type_map>
    <dataset_map>
        <dataset allowed_item_types="Item" named_ref="AsmFile" pdm_type="ProAsm"/>
        <dataset allowed_item_types="Item" named_ref="PrtFile" pdm_type="ProPrt"/>
        <dataset allowed_item_types="Item" named_ref="DrwFile" pdm_type="ProDrw"/>
        <dataset allowed_item_types="Item" named_ref="FrmFile" pdm_type="ProFrm"/>
        <dataset allowed_item_types="Item" named_ref="SecFile" pdm_type="ProSec"/>
        <dataset allowed_item_types="Item" named_ref="LayFile" pdm_type="ProLay"/>
        <dataset allowed_item_types="Item" named_ref="DgmFile" pdm_type="ProDgm"/>
        <dataset allowed_item_types="Item" named_ref="MfgFile" pdm_type="ProMfg"/>
        <dataset allowed_item_types="Item" named_ref="MrkFile" pdm_type="ProMrk"/>
        <dataset allowed_item_types="Item" named_ref="RepFile" pdm_type="ProRep"/>
        <dataset allowed_item_types="Item" named_ref="GphFile" pdm_type="ProGph"/>
        <dataset allowed_item_types="Item" named_ref="Pro2CemFile" pdm_type="Pro2Cem"/>
        <dataset allowed_item_types="Item" named_ref="JTPART" pdm_type="DirectModel"/>
    </dataset_map>
    <template_map>
        <template cad_type="PRT" path="{proe_common_dir}/templates/mmns_part_solid.prt"/>
        <template cad_type="ASM" path="{proe_common_dir}/templates/mmns_asm_design.asm"/>
        <template cad_type="DRW" path="{proe_common_dir}/templates/a1_drawing.drw"/>
    </template_map>
    <!-- Uncomment the attribute_map section below to enable the sample attribute mappings -->
    <!-- 
    <attribute_map cad_type="ASM:PRT">
        <attribute>
            <cad_name value="Description"/>
            <pdm_name value="item_name"/>
            <direction value="cadtopdm"/>
        </attribute>
        <attribute>
            <cad_name value="Description"/>
            <pdm_name value="ItemRevision.object_name"/>
            <direction value="both"/>
        </attribute>
        <attribute>
            <cad_name value="Revision"/>
            <pdm_name value="item_revision_id"/>
            <direction value="pdmtocad"/>
        </attribute>
    </attribute_map>
-->
    <auxiliary_file_map>
        <auxiliary_file cad_type="PRT" direction="cadtopdm">
            <!-- Uncomment the below if you want to give the user choice of saving the preview files -->
            <!-- cadtopdm_control label="Save Preview Files"/ -->
            <pdm_location named_ref="JPEG" pdm_type="ProPrt"/>
            <file_name pattern="{cad_directory}/{cad_name,lower}prt.JPG"/>
            <preview_command cmd="built_in {cad_directory}/{cad_name,lower}prt.JPG" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <auxiliary_file cad_type="ASM" direction="cadtopdm">
            <pdm_location named_ref="JPEG" pdm_type="ProAsm"/>
            <file_name pattern="{cad_directory}/{cad_name,lower}asm.JPG"/>
            <preview_command cmd="built_in {cad_directory}/{cad_name,lower}asm.JPG" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <auxiliary_file cad_type="DRW" direction="cadtopdm">
            <pdm_location named_ref="JPEG" pdm_type="ProDrw"/>
            <file_name pattern="{cad_directory}/{cad_name,lower}d.jpg"/>
            <preview_command cmd="built_in {cad_directory}/{cad_name,lower}d.jpg" ignore_status="true" phase="in_directory"/>
        </auxiliary_file>
        <auxiliary_file cad_type="ASM" direction="both">
            <pdm_location named_ref="AccelFile"/>
            <file_name pattern="{cad_name,lower}.xas"/>
        </auxiliary_file>
        <auxiliary_file cad_type="PRT" direction="both">
            <pdm_location named_ref="AccelFile"/>
            <file_name pattern="{cad_name,lower}.xpr"/>
        </auxiliary_file>
		<auxiliary_file cad_type="DRW" direction="cadtopdm">
			 <pdm_location pdm_type="PDF" named_ref="PDF_Reference"/>
			 <file_name pattern="{cad_name,lower}*.pdf"/>
			 <cadtopdm_control label="Save PDF Files" user_preference_default="true"/>
			 <pdf sheets="current"/>
		</auxiliary_file>
		<auxiliary_file cad_type="ASM:PRT" direction="cadtopdm">
			<pdm_location named_ref="Image" relation_type="IMAN_Rendering" pdm_type="Image"/>
			<file_name pattern="{cad_name,lower}.stp"/>
			<cadtopdm_control label="STEP" user_preference_default="true"/>
			<user_exit file_name="{cad_name,lower}.stp" ignore_status="true"/>
		</auxiliary_file>

        <jt_file action="translate" cad_type="ASM:PRT"/>
    </auxiliary_file_map>
    <bom_map>
        <bom_line child_type="ASM" parent_type="ASM" view_types="view"/>
        <bom_line child_type="PRT" parent_type="ASM" view_types="view"/>
        <bom_line child_type="JT" parent_type="ASM" view_types="view"/>
        <bom_line child_type="SWASM" parent_type="ASM" view_types="view"/>
        <bom_line child_type="SWPRT" parent_type="ASM" view_types="view"/>
        <bom_line child_type="SWPRT" parent_type="SWASM" view_types="view"/>
        <bom_line child_type="SWASM" parent_type="SWASM" view_types="view"/>
        <bom_line child_type="CATPART" parent_type="ASM" view_types="view"/>
        <bom_line child_type="CATPRODUCT" parent_type="ASM" view_types="view"/>
        <bom_line child_type="CATPART" parent_type="CATPRODUCT" view_types="view"/>
        <bom_line child_type="CATPRODUCT" parent_type="CATPRODUCT" view_types="view"/>
        <bom_line assembly="ignore" child_type="UGMASTER" parent_type="ASM" view_types="view"/>
        <bom_line assembly="ignore" child_type="UGMASTER" parent_type="UGMASTER" view_types="view"/>
        <bom_line child_type="AIPART" parent_type="ASM" view_types="view"/>
        <bom_line child_type="AIASSEMBLY" parent_type="ASM" view_types="view"/>
        <bom_line child_type="AIPART" parent_type="AIASSEMBLY" view_types="view"/>
        <bom_line child_type="AIASSEMBLY" parent_type="AIASSEMBLY" view_types="view"/>
        <bom_line child_type="SE PART" parent_type="ASM" view_types="view"/>
        <bom_line child_type="SE ASSEMBLY" parent_type="ASM" view_types="view"/>
        <bom_line child_type="SE PART" parent_type="SE ASSEMBLY" view_types="view"/>
        <bom_line child_type="SE ASSEMBLY" parent_type="SE ASSEMBLY" view_types="view"/>
    </bom_map>
</data_def>
