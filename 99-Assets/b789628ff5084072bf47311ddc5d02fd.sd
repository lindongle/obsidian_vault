##
#
# \brief         Mapping namespace for T4S engineering change master transfer
#
# \details       The namespace contains the custom specific part of a T4S engineering change master transfer:
#                \li Procedure \b TC_Object2SAP_ChangeMaster maps Teamcenter attributes to SAP attributes (so called \c mapping). 
#                \li Procedure \b SAP_ChangeMaster2TC_Object maps SAP attributes back to Teamcenter attributes (so called \c reverse \c mapping). 
#
# \note          For the data exchange between Teamcenter and T4S the internal TCL dictionary \c ::TcData is used.
#                It contains specific attributes of the Teamcenter object to be transferred 
#                and additional information about the current transaction. 
#                For the data exchange between T4S and SAP the internal TCL array \c ::SAPDat is used.\n
#                Teamcenter attributes can be read from \c ::TcData with function \c ::T4X::TC::MAPPING::FieldMapping.\n
#                Teamcenter attributes can be written to \c ::TcData with function \c ::T4X::TC::MAPPING::storeReverseMappingAttribute.\n 
#                SAP attributes can be read from \c ::SAPDat using function \c ::T4S::TC::MAPPING::SAPFieldMapping.\n
#                SAP attributes can be written to \c ::SAPDat with \c set \c ::SAPDat(<key>) \c value.\n 
#
# \pre           For the engineering change master transfer the following preferences are used:
#                \li \c T4S_ChangeMasterTypeList : list of allowed Teamcenter object types
#                \li \c T4S_ChangeMasterMapping4<ObjectType> : list of Teamcenter data types to read attributes from
#                \li \c T4S_ChangeMasterMapping2<ObjectType> : list of Teamcenter data types to write back during reverse mapping
#                \li \c T4S_ChangeMasterFieldMapping2<DataType> : list of Teamcenter attributes to write back during reverse mapping (optional)
#
# \author        M.L., 20130514
#
#
# ------------------------------------------------------------------------------------------------------ 

namespace eval ::T4S::ECM::CUSTOM::MAPPING {
  namespace export TC_Object2SAP_ChangeMaster
  namespace export SAP_ChangeMaster2TC_Object

  # ------------------------------------------------------------------------------------------------------
  # Method:        ::T4S::ECM::CUSTOM::MAPPING::TC_Object2SAP_ChangeMaster
  ##
  #
  # \brief         Customer specific mapping function to define the engineering change master to be transferred to SAP 
  #
  # \details       For \c ItemRevision the procedure maps the following Teamcenter attributes to SAP attributes:
  #                \n \c object_name -> \c SAP \c Description
  #                \n \c object_desc -> \c SAP \c Reason \c for \c change
  #                \n \c user_data_1 -> \c SAP \c Id
  #                \n \c user_data_2 -> \c SAP \c Valid \c from \c date \n
  #                For \c EngChange \c Revision the procedure maps the following Teamcenter attributes to SAP attributes:
  #                \n \c EngChange \c object_name -> \c SAP \c Description
  #                \n \c EngChange \c object_desc -> \c SAP \c Reason \c for \c change
  #                \n \c EngChange \c user_data_1 -> \c SAP \c Id
  #                \n \c EngChange \c user_data_2 -> \c SAP \c Valid \c from \c date \n
  #                For \c ChangeNoticeRevision the procedure maps following Teamcenter attributes to SAP attributes: 
  #                \n \c object_name -> \c Description
  #                \n \c object_desc -> line 1: \c Reason \c for \c change; line 2: \c Valid \c from \c date; line 3: \c SAP \c Id
  #
  # \note          The new created ECM may only be used for MM, BOM and DIR
  #
  # \param         TransactionId Unique ID for the transfer transaction
  # \param         ItemType Teamcenter item type
  # \param         ItemRevisionType Teamcenter item revision type
  # \param         args Not used
  #
  # \return        Return code used by the following transfer function. 
  #                The following values are valid:
  #                \n \c OK                 -> T4S will continue with the next transfer step
  #                \n \c REVERSEMAPPINGONLY -> T4S will skip the transfer to SAP and will just do the reverse mapping 
  #                \n \c SKIPPED            -> T4S will skip the transfer to SAP
  #                \n \c ERROR              -> T4S will stop transfer and raise an error
  #
  # \author        M.L., 20130514
  #
  # ------------------------------------------------------------------------------------------------------
  
  proc TC_Object2SAP_ChangeMaster {TransactionId ItemType ItemRevisionType args} {

    # Reset some internal variables
    set ::errorCode "NONE"
    set ::errorInfo ""
  
    # Define default return code
    set rc "OK"

    # Store procedure name in variable
    set FunctionName "[lindex [info level 0] 0]"

    # Write information to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName starts with $ItemType, $ItemRevisionType"

    # Define some relation name strings
    set Item                 "$ItemRevisionType:items_tag:$ItemType"
    set ItemMaster           "$Item:IMAN_master_form:$ItemType Master"
    set ItemRev              $ItemRevisionType
    set ItemRevMaster        "$ItemRevisionType:IMAN_master_form_rev:$ItemRevisionType Master"
      
    # Read some attributes from Teamcenter object and define some helpful variables
#    #可以根据不用的变更类型，设置不同的属性映射。以下描述了不同的取值和赋值方式。
#    if {$ItemType eq "ChangeNotice"} {
#	  #变更的信息均在描述中读取
#      set SAPName                 [::T4X::TC::MAPPING::FieldMapping $ItemRev object_name];     # object_name is used for description
#      set SAPDesc                 [::T4X::TC::MAPPING::FieldMapping $ItemRev object_desc] ;    # contains reason, valid from date, SAP Id if data exist in SAP and transfer status
#      set ChangeMasterDescription $SAPName

#      # Decode SAPDesc
#	  #OOTB配置文件在描述中定义变更原因、有效起始日期、SAP对应物料编号、发送状态，用回车换行隔开
#      set SAPReason         ""
#      set SAPValidFrom      ""
#      set SAPId             ""
#      set T4STransferStatus ""
#	  #用换行符分隔上述四个信息
#      set listDesc          [split $SAPDesc "\n"]; 
#      if {[llength $listDesc] > 0} {
#		#如果只有1行，则描述为变更原因
#        set SAPReason         [lindex $listDesc 0];  # contains reason
#      }
#      if {[llength $listDesc] > 1} {
#		#如果有2/3行，则第2行为有效起始日期
#        set SAPValidFrom      [lindex $listDesc 1];  # contains valid from date
#      }
#      if {[llength $listDesc] == 4} { ;# Otherwise it is a description
#		#第3行为SAP对应物料编号
#        set SAPId             [lindex $listDesc 2];  # contains SAP Id if data exist in SAP
#		#如果有4行，则第4行为传输状态，如果不传输，永远为空。
#        set T4STransferStatus [lindex $listDesc 3];  # it is empty if item was never transferred before
#      }
#      
#   } elseif {$ItemType eq "EngChange"} { 
#	  #变更信息分别从item或item版本属性中取
#      set SAPDesc           [::T4X::TC::MAPPING::FieldMapping $Item object_name];         # object_name is used for description
#      set SAPReason         [::T4X::TC::MAPPING::FieldMapping $Item object_desc] ;        # object_desc is used for reason
#      set SAPId             [::T4X::TC::MAPPING::FieldMapping $ItemMaster user_data_1];   # contains SAP Id if data exist in SAP
#      set SAPValidFrom      [::T4X::TC::MAPPING::FieldMapping $ItemMaster user_data_2];   # transfer this value as VALID_FROM
#      set T4STransferStatus [::T4X::TC::MAPPING::FieldMapping $ItemMaster item_comment];  # it is empty if item was never transferred before
#      set ChangeMasterDescription $SAPDesc
#
#    } else { ;# ($ItemType eq "Item")
#     #变更信息从item版本或版本表单上取
#      set SAPDesc           [::T4X::TC::MAPPING::FieldMapping $ItemRev object_name];         # object_name is used for description
#      set SAPReason         [::T4X::TC::MAPPING::FieldMapping $ItemRev object_desc] ;        # object_desc is used for reason
#      set SAPId             [::T4X::TC::MAPPING::FieldMapping $ItemRevMaster user_data_1];   # contains SAP Id if data exist in SAP
#      set SAPValidFrom      [::T4X::TC::MAPPING::FieldMapping $ItemRevMaster user_data_2];   # transfer this value as VALID_FROM
#      set T4STransferStatus [::T4X::TC::MAPPING::FieldMapping $ItemRevMaster item_comment];  # it is empty if item was never transferred before
#      set ChangeMasterDescription $SAPDesc
#    }
    if {$ItemType eq "DZ8_DJ_ECN"} {
      set SAPDesc           [::T4X::TC::MAPPING::FieldMapping $ItemRev object_name];         # object_name is used for description
      set SAPReason         [::T4X::TC::MAPPING::FieldMapping $ItemRev dz8_changereason] ;        # object_desc is used for reason
      set SAPId             [::T4X::TC::MAPPING::FieldMapping $Item item_id];   # contains SAP Id if data exist in SAP
      set SAPValidFrom      [::T4X::TC::MAPPING::FieldMapping $ItemRev data_released];   # transfer this value as VALID_FROM
      set T4STransferStatus [::T4X::TC::MAPPING::FieldMapping $ItemRev dz8_sapcomment];  # it is empty if item was never transferred before
      set ChangeMasterDescription $SAPDesc
    } 



    # Define the change no
	#变更单号转为大写
    set SAPChangeNo       [string toupper [string trim $SAPId]]
    
    # Make sure that internal change number format is used for all transactions
    if {[string length $SAPChangeNo] > 0} { 
	#将变更单号转为SAP内部格式
      set SAPChangeNo [::TPSAP::ECM::getInternalChangeNumber $SAPChangeNo]
    }

    # If no valid from date is specified set it to today
	#如果有效起始日期为空，则默认今天
    if {[string trim $SAPValidFrom] eq ""} {
      set SAPValidFrom [clock format [clock seconds] -format "%d.%m.%Y"]
    } else {
		  #如果有效起始日期为空，则默认今天
		set SAPValidFrom  [format "%d.%m.%Y" $SAPValidFrom]
      }
		
    # Store data to the data exchange array ::SAPDat
    #
    set ::SAPDat(ChangeMaster:HeadData:CHANGE_NO)   $SAPChangeNo
    set ::SAPDat(ChangeMaster:HeadData:VALID_FROM)  $SAPValidFrom
    set ::SAPDat(ChangeMaster:HeadData:STATUS)      "01"
    set ::SAPDat(ChangeMaster:HeadData:DESCRIPT)    $ChangeMasterDescription
    set ::SAPDat(ChangeMaster:HeadData:AUTH_GROUP)  ""
    set ::SAPDat(ChangeMaster:HeadData:REASON_CHG)  $SAPReason
	set ::SAPDat(ChangeMaster:HeadData:AUTH_GROUP)  $::T4S_Defaults(Plant)
       
    # Write return code to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName returns $rc"
    
    return $rc
  }
    
  # ------------------------------------------------------------------------------------------------------
  # Method:        ::T4S::ECM::CUSTOM::MAPPING::SAP_ChangeMaster2TC_Object
  ##
  #
  # \brief         Customer specific reverse mapping function for the T4S engineering change master transfer
  #
  # \details       For \c ItemRevision the procedure maps the following SAP attributes back to Teamcenter attributes: 
  #                \n \c SAP \c Id -> \c user_data_1
  #                \n \c SAP \c Valid \c from \c date -> \c user_data_2
  #                \n \c T4S \c transfer \c status -> \c item_comment  \n
  #                For \c EngChange \c Revision the procedure maps the following SAP attributes back to Teamcenter attributes: 
  #                \n \c SAP \c Id -> \c EngChange \c user_data_1
  #                \n \c SAP \c Valid \c from \c date -> \c EngChange \c user_data_2
  #                \n \c T4S \c transfer \c status -> \c EngChange \c item_comment  \n
  #                For \c ChangeNoticeRevision the procedure maps following SAP attributes back to Teamcenter attributes: 
  #                \n \c SAP \c Reason c\ for \c change, \c SAP \c Valid \c from \c date, \c SAP \c Id and \c T4S \c transfer \c status -> \c object_desc
  #
  # \param         TransactionId Unique ID for the transfer transaction
  # \param         ItemType Teamcenter item type
  # \param         ItemRevisionType Teamcenter item revision type
  # \param         Status SAP transfer status. 
  #                The following values are valid:
  #                \n \c SKIPPED                   -> the transfer was skipped
  #                \n \c ERROR                     -> the transfer was stopped by an error
  #                \n \c UNKNOWN                   -> the transfer was stopped by an unknown error
  #                \n \c UPDATED_WITH_ERROR        -> the transfer was stopped by an minor error in one of the additional transfer steps
  #                \n \c CREATED, \c CHANGED, \c UPDATED -> and some other values are used for a successful transfer
  # \param         ObjectKey - SAP Id of change master
  # \param         args Not used
  #
  # \return        Return code used by the following Tc object update function. 
  #                The following values are valid:
  #                \n \c OK                 -> T4S will update the Tc object based on the reverse mapping preferences and the reverse mapping buffer
  #                \n \c SKIPPED            -> T4S will skip the TcData object
  #                \n \c ERROR              -> T4S will stop transfer and raise an error
  #
  # \author        M.L., 20130405
  #
  # ------------------------------------------------------------------------------------------------------
  
  proc SAP_ChangeMaster2TC_Object {TransactionId ItemType ItemRevisionType Status ObjectKey args} {

    # Reset some internal variables
    set ::errorCode "NONE"
    set ::errorInfo ""
  
    # Define default return code
    set rc "OK"

    # Store procedure name in variable
    set FunctionName "[lindex [info level 0] 0]"
    
    # Write information to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName starts with $ItemType, $ItemRevisionType, $Status, $ObjectKey"

    # Define some relation name strings
    set Item                 "$ItemRevisionType:items_tag:$ItemType"
    set ItemMaster           "$Item:IMAN_master_form:$ItemType Master"
    set ItemRev              $ItemRevisionType
    set ItemRevMaster        "$ItemRevisionType:IMAN_master_form_rev:$ItemRevisionType Master"

    # Return in case of prohibited action
    foreach data [array names ::SAPDat "CtrlParam:ProhibitedAction"] {
      set rc "SKIPPED"
      tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName returns $rc"
      return $rc
    }
    
    # Read some attributes from SAP object and define transfer status string
    # Store data to Teamcenter and write information to session log
    #
    set SAPId        $ObjectKey
    set SAPValidFrom [::T4S::TC::MAPPING::SAPFieldMapping ChangeMaster $ObjectKey VALID_FROM]
    set SAPReason    [::T4S::TC::MAPPING::SAPFieldMapping ChangeMaster $ObjectKey REASON_CHG]
    
    if {($Status eq "ERROR") || ($Status eq "UNKNOWN") || ($Status eq "SKIPPED")} {
      set T4STransferStatus "ECM transfer $Status - [clock format [clock seconds] -format "%Y-%m-%d %R"]"
      #
      if {$ItemType eq "DZ8_DJ_ECN"} {
#        set SAPDesc "$SAPReason\n$SAPValidFrom\n$SAPId\n$T4STransferStatus"
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'object_desc': '$SAPDesc' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev object_desc $SAPDesc
#      } elseif {$ItemType eq "EngChange"} {
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'dz8_sapcomment': '$T4STransferStatus' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev dz8_sapcomment $T4STransferStatus
#      } else { ;# ($ItemType eq "Item")
       tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'dz8_sapcomment': '$T4STransferStatus' ++++++++++"  
        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev dz8_sapcomment $T4STransferStatus
#      }
    #
    } else {
      if {$Status eq "UPDATED_WITH_ERROR"} {
        set T4STransferStatus "ECM transfer $Status - [clock format [clock seconds] -format "%Y-%m-%d %R"]"
      } else {
        set T4STransferStatus "ECM transferred to $::T4S::SapInfo(SapSystem) at [clock format [clock seconds] -format "%Y-%m-%d %R"]"
      }
      #
#      if {$ItemType eq "ChangeNotice"} {
#        set SAPDesc "$SAPReason\n$SAPValidFrom\n$SAPId\n$T4STransferStatus"
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'object_desc': '$SAPDesc' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev object_desc $SAPDesc
#      } elseif {$ItemType eq "EngChange"} {
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'item_id': '$SAPId' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $Item item_id $SAPId
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'data_released': '$SAPValidFrom' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev data_released $SAPValidFrom
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'item_id': '$T4STransferStatus' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev item_id $T4STransferStatus
#      } else { ;# ($ItemType eq "Item")
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'item_id': '$SAPId' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $Item user_data_1 $SAPId
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'data_released': '$SAPValidFrom' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev user_data_2 $SAPValidFrom
#        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'dz8_sapcomment': '$T4STransferStatus' ++++++++++"  
#        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev dz8_sapcomment $T4STransferStatus
#      }

      if {$ItemType eq "DZ8_DJ_ECN"} {
        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'item_id': '$SAPId' ++++++++++"  
        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $Item user_data_1 $SAPId
        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'data_released': '$SAPValidFrom' ++++++++++"  
        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev user_data_2 $SAPValidFrom
        tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "++++++++++ Reverse mapping value 'dz8_sapcomment': '$T4STransferStatus' ++++++++++"  
        ::T4X::TC::MAPPING::storeReverseMappingAttribute ChangeMaster $ItemRev dz8_sapcomment $T4STransferStatus
      }
    }
    # Write return code to session log
    tpwrite -logchannel [::T4X::CORE::getSessionLogChannel] -mtype INTERN "$FunctionName returns $rc"
    
    return $rc
  }
  
}