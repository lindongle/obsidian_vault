color:#2E75B5'> </span>[2]":[84,95],"##<span style='color:#2E75B5'> </span>[2]#{1}":[85,95]},"outlinks":[{"title":"image1","target":"a3962535ca9c4e088672bbee2e7d10bd.jpg","line":91,"embedded":true}],"metadata":{"title":"三分钟了解Oracle内存管理方式 - 墨天轮","updated":"2026-06-06T00:31","created":"2025-11-25T23:25:25"},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:30-Resouces/01-Software/02.DB/三分钟了解Oracle内存管理方式 - 墨天轮.md#": {"path":null,"last_embed":{"hash":"5vvimk","at":1781360194397},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04943286,-0.03390013,-0.00853323,-0.0901399,0.01244312,-0.0466606,-0.06032704,-0.000726,-0.00160457,0.00584561,0.01509326,-0.06622584,0.04378297,-0.00990373,0.00821594,0.00239846,0.04691839,-0.04179906,0.02084069,0.0192433,0.06227433,-0.00936931,0.01242331,-0.03495862,0.01869398,0.05279944,0.00533668,-0.09097064,-0.0086037,-0.18787621,-0.01909276,0.00714981,0.02940627,-0.0006973,0.0212513,-0.02231181,-0.04440667,0.0229266,-0.05353444,0.00553701,0.0068285,0.02410812,0.02711837,0.01640636,0.0047009,-0.03449055,0.00487548,-0.03110431,0.07333528,0.02594844,-0.05044399,0.0698804,0.01678739,0.00452976,-0.00282649,-0.03595733,0.07801831,0.10197117,0.02469503,0.02571243,0.04978637,0.0177632,-0.17742026,0.07799014,-0.01321253,-0.00341652,-0.03426176,-0.01747501,0.02610165,0.04164402,-0.05367526,0.03646779,-0.01462821,0.03896036,0.02510944,-0.03782193,0.0236599,-0.08034101,-0.0426898,-0.02187303,-0.00269543,0.05250001,-0.03837996,-0.00113406,-0.03489455,-0.03405845,0.02553948,-0.05698164,0.01936768,-0.01878897,0.0137508,0.00263665,0.0157041,0.04041681,-0.05685388,0.01519311,0.00681085,0.06022985,0.03169656,0.08883279,-0.01972748,0.02442385,-0.06785817,-0.05217708,0.04866786,-0.03012429,0.01359617,-0.06742164,-0.01410808,0.05057234,-0.02513647,-0.03046902,0.06426992,-0.07821941,-0.00408127,0.02016286,0.02901693,-0.011379,-0.06742277,-0.00813695,0.00163606,0.00749814,0.01076434,-0.02463435,0.02834207,-0.03144184,0.03883046,0.0336944,0.04874856,0